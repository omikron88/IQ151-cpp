# Embed original ROM bytes; no external ROM files are needed at runtime.
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
set(ASSET_CPP "${CMAKE_CURRENT_BINARY_DIR}/generated/assets.cpp")
file(WRITE "${ASSET_CPP}" "#include \"iq151/machine.hpp\"\n#include <stdexcept>\n#include <cstring>\nnamespace iq151 {\n")
file(GLOB ASSET_FILES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/roms/*")
set(ASSET_TABLE "")
foreach(ASSET_FILE IN LISTS ASSET_FILES)
    get_filename_component(ASSET_NAME "${ASSET_FILE}" NAME)
    string(MAKE_C_IDENTIFIER "${ASSET_NAME}" ASSET_ID)
    file(READ "${ASSET_FILE}" ASSET_HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ASSET_HEX "${ASSET_HEX}")
    file(APPEND "${ASSET_CPP}" "static const unsigned char ${ASSET_ID}[] = {${ASSET_HEX}};\n")
    string(APPEND ASSET_TABLE "{\"${ASSET_NAME}\",${ASSET_ID},sizeof(${ASSET_ID})},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ASSET_FILE}")
endforeach()
file(APPEND "${ASSET_CPP}" "static const Asset assets[] = {${ASSET_TABLE}};\nconst Asset& asset(const std::string& name) {for(const auto& a:assets) if(name==a.name) return a; throw std::runtime_error(\"Unknown embedded asset: \"+name);}\n}\n")
